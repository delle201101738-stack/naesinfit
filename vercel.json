{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/mock.js": {
      "maxDuration": 60
    },
    "api/interview.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mo/:t",
      "destination": "/api/rpage?mo=1&t=:t"
    },
    {
      "source": "/iv/:t",
      "destination": "/api/rpage?iv=1&t=:t"
    },
    {
      "source": "/r/:t",
      "destination": "/api/rpage?t=:t"
    },
    {
      "source": "/r",
      "destination": "/api/rpage"
    }
  ]
}