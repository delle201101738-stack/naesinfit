{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/report",
      "has": [
        {
          "type": "query",
          "key": "student"
        }
      ],
      "destination": "/api/rpage"
    }
  ]
}